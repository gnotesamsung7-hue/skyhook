<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Skyhook: Tanod ng Langit VR</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Barlow:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#14181d; --bone:#ece6da; --ember:#ff7a2a; --blood:#e2483d; --mutya:#8fe6ff; --gold:#ffd24a;
  --panel:rgba(20,24,29,.86); --muted:#b9b2a5; --row:rgba(255,255,255,.06);
  color-scheme:dark;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){ --panel:rgba(14,17,21,.9); --bone:#ece6da; --muted:#b0a99c; --row:rgba(255,255,255,.06); }
}
:root[data-theme="dark"]{ --panel:rgba(14,17,21,.9); --bone:#ece6da; --muted:#b0a99c; --row:rgba(255,255,255,.06); }
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{margin:0;height:100%;overflow:hidden;background:var(--ink);color:var(--bone);
  font-family:"Barlow",system-ui,-apple-system,"Segoe UI",sans-serif}
canvas{display:block}
.panel{position:fixed;left:clamp(16px,5vw,64px);top:50%;transform:translateY(-50%);
  width:min(560px,calc(100% - 32px));max-height:calc(100% - 32px);overflow:auto;
  background:var(--panel);border-left:6px solid var(--ember);padding:28px 30px;border-radius:4px 14px 14px 4px;
  backdrop-filter:blur(6px)}
h1{font-family:"Big Shoulders Display",Impact,"Arial Narrow",sans-serif;font-weight:900;
  font-size:clamp(56px,10vw,96px);line-height:.85;margin:0;letter-spacing:.01em}
h2{font:900 30px "Big Shoulders Display",Impact,sans-serif;margin:22px 0 10px}
.sub{font-family:"Big Shoulders Display",Impact,sans-serif;font-weight:700;font-size:24px;color:var(--ember);margin:6px 0 16px}
p{line-height:1.5;margin:0 0 14px;max-width:62ch}
details{background:var(--row);border-radius:10px;padding:10px 14px;margin:4px 0 8px}
summary{cursor:pointer;font-weight:600}
details p{margin:12px 0 0;font-size:15px}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:14px;color:var(--muted);margin-top:12px}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:middle}
#missionList{display:grid;gap:6px}
.mission{display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:10px;text-align:left;width:100%;
  background:var(--row);color:var(--bone);border:2px solid transparent;border-radius:10px;padding:10px 12px;font:600 16px "Barlow",sans-serif;cursor:pointer}
.mission .n{font:900 26px "Big Shoulders Display",Impact,sans-serif;color:var(--ember)}
.mission .st{font-size:13px;color:var(--muted);font-weight:400}
.mission[aria-pressed="true"]{border-color:var(--ember)}
.mission:disabled{opacity:.4;cursor:not-allowed}
.btns{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0 8px}
button.main{font:600 17px "Barlow",system-ui,sans-serif;padding:12px 20px;border-radius:999px;border:2px solid var(--ember);
  background:var(--ember);color:var(--ink);cursor:pointer}
button.ghost{background:transparent;color:var(--bone)}
button:disabled{opacity:.45;cursor:not-allowed}
button:focus-visible{outline:3px solid var(--bone);outline-offset:3px}
.note{font-size:14px;color:var(--muted);min-height:1em}
.controls{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:14px;font-size:14px}
.controls h3{font:700 18px "Big Shoulders Display",sans-serif;margin:0 0 6px;color:var(--ember)}
.controls dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:4px 10px}
.controls dt{font-weight:600;white-space:nowrap}
.controls dd{margin:0;color:var(--muted)}
@media (max-width:560px){.controls{grid-template-columns:1fr}}
#hud{position:fixed;top:calc(14px + env(safe-area-inset-top,0px));left:16px;display:none;flex-direction:column;gap:6px;
  text-shadow:0 2px 4px rgba(0,0,0,.7)}
#hud .row{display:flex;gap:14px;align-items:center;font:700 24px "Big Shoulders Display",sans-serif}
#hearts{color:var(--blood);letter-spacing:3px}
#gasWrap{width:140px;height:10px;border-radius:6px;background:rgba(0,0,0,.45);overflow:hidden}
#gas{height:100%;width:100%;background:var(--bone)}
#obj{font:600 17px "Barlow",sans-serif}
#stats{font:400 15px "Barlow",sans-serif;color:var(--bone)}
#cross{position:fixed;left:50%;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px;border:2px solid var(--bone);border-radius:50%;
  display:none;mix-blend-mode:difference}
#msg{position:fixed;left:0;right:0;top:18%;text-align:center;pointer-events:none;opacity:0;transition:opacity .3s;padding:0 20px;
  text-shadow:0 3px 10px rgba(0,0,0,.7)}
#msg .t{font:900 clamp(34px,6vw,64px) "Big Shoulders Display",sans-serif}
#msg .s{font:600 clamp(16px,2.2vw,22px) "Barlow",sans-serif;max-width:46ch;margin:8px auto 0;line-height:1.4}
.hidden{display:none!important}
@media (prefers-reduced-motion: reduce){#msg{transition:none}}
</style>
</head>
<body>
<div id="start" class="panel">
  <h1>Skyhook</h1>
  <p class="sub">Tanod ng Langit</p>
  <p>The forest spirits have come for Barangay Maligaya. Swing over the rooftops on twin grapple lines and cut down the kapre and tikbalang before they reach the church.</p>
  <details>
    <summary>Read the story</summary>
    <p>Barangay Maligaya was getting ready for its fiesta when a developer cut down the old balete tree at the edge of town to make room for new condo towers. That night, the spirits who lived in it woke up angry.</p>
    <p>Out of the dusk came the kapre, tree giants as tall as the bell tower, cigars glowing in their mouths. With them ran the tikbalang, horse-headed tricksters on long legs, faster than any jeepney.</p>
    <p>Lolo Isko, the barangay’s old panday, had been waiting for this night. He hands you the rig his own lolo built: two grapple lines spun from lubid-kidlat, the lightning rope, and twin bolo blades hammered from a fallen star. You are the newest Tanod ng Langit, the sky guardian of Maligaya.</p>
    <p>“Every kapre carries its mutya,” Lolo Isko tells you, “a glowing pearl lodged in its back. Every tikbalang hides golden hairs in its mane. Strike those, and the spirit goes back to the forest.”</p>
  </details>
  <div class="legend"><span><span class="dot" style="background:var(--mutya)"></span>Kapre weak spot: the mutya on its back</span><span><span class="dot" style="background:var(--gold)"></span>Tikbalang weak spot: the golden hairs in its mane</span></div>
  <h2>Missions</h2>
  <div id="missionList"></div>
  <div class="btns">
    <button id="vrBtn" class="main" disabled>Checking for VR…</button>
    <button id="deskBtn" class="main ghost">Play on this screen</button>
  </div>
  <p id="vrNote" class="note"></p>
  <div class="controls">
    <div><h3>Quest controllers</h3><dl>
      <dt>Trigger</dt><dd>Fire that hand’s grapple, hold to stay hooked</dd>
      <dt>Grip</dt><dd>Reel in hard (uses gas)</dd>
      <dt>Swing arms</dt><dd>Your blades cut on contact</dd>
      <dt>Left stick</dt><dd>Run, or steer in the air</dd>
      <dt>Right stick</dt><dd>Snap turn</dd>
      <dt>A</dt><dd>Jump</dd>
    </dl></div>
    <div><h3>Keyboard and mouse</h3><dl>
      <dt>Mouse</dt><dd>Look (click to lock)</dd>
      <dt>Left click</dt><dd>Grapple, hold</dd>
      <dt>E</dt><dd>Second grapple, hold</dd>
      <dt>Shift</dt><dd>Reel in</dd>
      <dt>Right click / F</dt><dd>Slash</dd>
      <dt>WASD, Space</dt><dd>Move, jump</dd>
    </dl></div>
  </div>
  <p class="note" style="margin-top:14px">Fast swinging can be intense in VR. Play seated or standing in a clear space, and take breaks.</p>
</div>

<div id="over" class="panel hidden">
  <h1 id="overTitle">Tumba!</h1>
  <p class="sub" id="overStats"></p>
  <p id="overText"></p>
  <div class="btns"><button id="primaryBtn" class="main">Try again</button><button id="menuBtn" class="main ghost">Mission list</button></div>
</div>

<div id="hud"><div class="row"><span id="hearts">♥♥♥</span><div id="gasWrap"><div id="gas"></div></div></div>
  <div id="obj"></div><div id="stats"></div></div>
<div id="cross"></div>
<div id="msg"><div class="t"></div><div class="s"></div></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
"use strict";
const $=id=>document.getElementById(id);
const V=()=>new THREE.Vector3();
const rand=(a,b)=>a+Math.random()*(b-a);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
let seed=11; const srand=()=>{seed=(seed*16807)%2147483647;return (seed-1)/2147483646;};

/* ---------- renderer / scene ---------- */
const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
renderer.setSize(innerWidth,innerHeight);
renderer.outputEncoding=THREE.sRGBEncoding;
renderer.xr.enabled=true;
document.body.prepend(renderer.domElement);

const scene=new THREE.Scene();
const SKY=0xe9a978; // takipsilim (dusk)
scene.background=new THREE.Color(SKY);
scene.fog=new THREE.Fog(SKY,80,300);
const camera=new THREE.PerspectiveCamera(75,innerWidth/innerHeight,0.05,700);
const rig=new THREE.Group(); rig.add(camera); scene.add(rig);
camera.position.set(0,1.7,0);
rig.position.set(0,0,12);

scene.add(new THREE.HemisphereLight(0xffd2b0,0x4a3a30,0.85));
const sun=new THREE.DirectionalLight(0xffa868,0.95); sun.position.set(-130,45,30); scene.add(sun);

const hookables=[], boxes=[];
const ground=new THREE.Mesh(new THREE.PlaneGeometry(700,700),new THREE.MeshStandardMaterial({color:0x8d8873,roughness:1}));
ground.rotation.x=-Math.PI/2; scene.add(ground); hookables.push(ground);
const boxGeo=new THREE.BoxGeometry(1,1,1);

/* ---------- Filipino town, merged into one mesh so the Quest stays smooth ---------- */
const mPos=[],mNor=[],mCol=[],wPos=[],fPos=[];
const _m=new THREE.Matrix4(),_q=new THREE.Quaternion(),_s=V(),_p=V(),_e=new THREE.Euler(),_c=new THREE.Color(),_n3=new THREE.Matrix3(),_v=V();
const GB=new THREE.BoxGeometry(1,1,1).toNonIndexed();
const GC=new THREE.CylinderGeometry(1,1,1,8).toNonIndexed();
const GPY=new THREE.ConeGeometry(1,1,4).rotateY(Math.PI/4).toNonIndexed();
const GPR=new THREE.CylinderGeometry(1,1,1,3).rotateX(-Math.PI/2).toNonIndexed();
const GTD=new THREE.ConeGeometry(1,1,3).rotateX(Math.PI).toNonIndexed();
const GI=new THREE.IcosahedronGeometry(1,0);
const pick=a=>a[Math.floor(srand()*a.length)];
function put(geo,col,x,y,z,sx,sy,sz,rx,ry,rz){
  _p.set(x,y,z);_e.set(rx||0,ry||0,rz||0);_q.setFromEuler(_e);_s.set(sx,sy,sz);_m.compose(_p,_q,_s);_n3.getNormalMatrix(_m);_c.set(col);
  const pa=geo.attributes.position.array,na=geo.attributes.normal.array;
  for(let i=0;i<pa.length;i+=3){_v.set(pa[i],pa[i+1],pa[i+2]).applyMatrix4(_m);mPos.push(_v.x,_v.y,_v.z);
    _v.set(na[i],na[i+1],na[i+2]).applyMatrix3(_n3).normalize();mNor.push(_v.x,_v.y,_v.z);mCol.push(_c.r,_c.g,_c.b);}
}
function solid(a,b,c,d,h){boxes.push({minX:a,maxX:b,minZ:c,maxZ:d,maxY:h});}

// shop signs (canvas textures)
const signList=[];
function signMat(text,bg,fg){const k=text+'|'+bg;let e=signList.find(s=>s.k===k);if(e)return e.mat;
  const c=document.createElement('canvas');c.width=512;c.height=128;const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;
  const draw=()=>{const g=c.getContext('2d');g.fillStyle=bg;g.fillRect(0,0,512,128);g.strokeStyle=fg;g.lineWidth=8;g.strokeRect(8,8,496,112);
    g.fillStyle=fg;g.textAlign='center';g.textBaseline='middle';let fs=72;
    do{g.font=`900 ${fs}px "Big Shoulders Display", Impact, sans-serif`;fs-=4;}while(g.measureText(text).width>460&&fs>28);
    g.fillText(text,256,68);t.needsUpdate=true;};
  draw();e={k,mat:new THREE.MeshBasicMaterial({map:t}),draw};signList.push(e);return e.mat;}
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>signList.forEach(s=>s.draw()));
const signGeo=new THREE.PlaneGeometry(1,.25);
function sign(s,x,y,z,w,ry){const m=new THREE.Mesh(signGeo,signMat(s[0],s[1],s[2]));m.scale.set(w,w,1);m.position.set(x,y,z);m.rotation.y=ry||0;scene.add(m);}
const SIGNS=[['SARI-SARI STORE','#f4d23c','#b3261e'],['PANADERIA','#f6efe0','#7a3b16'],['KARINDERYA','#c8302a','#fff6e0'],['VULCANIZING','#1f4fa3','#ffffff'],
  ['LECHON MANOK','#f08a24','#3b1a0a'],['BIGASAN','#2f8a4a','#ffffff'],['BOTIKA','#ffffff','#1f6fb3'],['LOAD DITO','#e6267e','#ffffff'],
  ['BARBERSHOP','#20262c','#f4d23c'],['HALO-HALO','#7b4bb7','#fff6e0'],['COMPUTER SHOP','#0f7f8c','#ffffff'],['PARLOR','#f7c6d9','#8a1c4a']];

function bahay(x,z,w,d){ // bahay na bato: stone ground floor, wooden upper floor with capiz windows
  const stone=pick([0xc2b49a,0xb3a68c,0xcabda2]),wood=pick([0x6b4a32,0x7a5537,0x5e4030]),roof=pick([0x9a4a33,0x7d3b2c,0x8c8f93]);
  put(GB,stone,x,1.75,z,w,3.5,d);
  const W=w+1.2,D=d+1.2;put(GB,wood,x,5.25,z,W,3.5,D);
  const n=Math.max(2,Math.floor(W/2.2)),m=Math.max(2,Math.floor(D/2.2));
  for(let k=0;k<n;k++){const o=-W/2+(k+.5)*W/n;put(GB,0xf2e8cc,x+o,5.5,z+D/2+.03,W/n*.68,1.7,.08);put(GB,0xf2e8cc,x+o,5.5,z-D/2-.03,W/n*.68,1.7,.08);}
  for(let k=0;k<m;k++){const o=-D/2+(k+.5)*D/m;put(GB,0xf2e8cc,x+W/2+.03,5.5,z+o,.08,1.7,D/m*.68);put(GB,0xf2e8cc,x-W/2-.03,5.5,z+o,.08,1.7,D/m*.68);}
  put(GB,0x3a2a1e,x,1.3,z+d/2+.03,1.8,2.6,.08);
  put(GB,0x4a3a2a,x-w*.32,1.9,z+d/2+.03,1.1,1.2,.08);put(GB,0x4a3a2a,x+w*.32,1.9,z+d/2+.03,1.1,1.2,.08);
  put(GPY,roof,x,8.4,z,(W+1.4)/1.414,2.8,(D+1.4)/1.414);
  solid(x-W/2,x+W/2,z-D/2,z+D/2,7);
}
function apartment(x,z,w,d,floors){
  const h=floors*3.2,col=pick([0xe9b7b0,0xb9dcc4,0xf0d98c,0xa9c8e4,0xe8e1d1,0xd9a37a,0xc7b6e0]),shop=floors<=3&&srand()<.8;
  put(GB,col,x,h/2,z,w,h,d);
  for(let f=0;f<floors;f++){const y=f*3.2+1.9;
    if(!(f===0&&shop))put(GB,0x33393f,x,y,z+d/2+.02,w*.8,1.1,.06);
    put(GB,0x33393f,x,y,z-d/2-.02,w*.8,1.1,.06);put(GB,0x33393f,x+w/2+.02,y,z,.06,1.1,d*.8);put(GB,0x33393f,x-w/2-.02,y,z,.06,1.1,d*.8);
    if(f>0&&srand()<.5)put(GB,0x9a9a9a,x,f*3.2+.5,z+d/2+.5,w*.5,.15,1);}
  if(shop){put(GB,0x5a5f64,x,1.1,z+d/2+.03,w*.8,2.2,.06);sign(pick(SIGNS),x,2.75,z+d/2+.07,Math.min(w*.8,7.5));}
  put(GC,0x2e6db4,x+w*.25,h+.9,z-d*.2,1,1.8,1);put(GB,0x8d8d8d,x-w*.2,h+.6,z,2,1.2,2);
  solid(x-w/2,x+w/2,z-d/2,z+d/2,h);
}
function tower(x,z,w,d,h){ // city-center condo / office tower
  const glass=pick([0x5d7d96,0x6a8aa0,0x4f6d84,0x7895a6]);
  put(GB,glass,x,h/2,z,w,h,d);
  for(let y=3.5;y<h;y+=3.5)put(GB,0xd5dbe0,x,y,z,w+.12,.35,d+.12);
  put(GB,0xd5dbe0,x,h+1.5,z,w*.6,3,d*.6);
  solid(x-w/2-.06,x+w/2+.06,z-d/2-.06,z+d/2+.06,h);
}
function store(x,z){ // sari-sari store
  put(GB,pick([0xbfa27a,0xd8c7a4,0x9fc2b0]),x,1.5,z,5,3,4);
  put(GB,0x9ca3a8,x,3.25,z+.3,5.8,.12,5.2,-.12,0,0);
  put(GB,0x2a2a2a,x,1.6,z+2.02,3.4,1,.05);
  sign(SIGNS[0],x,2.55,z+2.06,3.8);
  solid(x-2.5,x+2.5,z-2,z+2,3);
}
function coco(x,z,h){ // coconut tree
  const lz=(srand()-.5)*.35,lx=(srand()-.5)*.35;_e.set(lx,0,lz);_v.set(0,1,0).applyEuler(_e);
  const tx=x+_v.x*h,ty=_v.y*h,tz=z+_v.z*h;
  put(GC,0x8a7357,(x+tx)/2,ty/2,(z+tz)/2,.22,h,.22,lx,0,lz);
  for(let k=0;k<8;k++){const a=k/8*Math.PI*2+srand()*.3;put(GB,pick([0x3f7d2c,0x4f8f34,0x376e26]),tx+Math.cos(a)*1.6,ty-.35,tz-Math.sin(a)*1.6,3.4,.06,.75,0,a,-.38);}
  for(let k=0;k<3;k++)put(GI,0x5b4022,tx+Math.cos(k*2.1)*.3,ty-.45,tz+Math.sin(k*2.1)*.3,.24,.24,.24);
}
const JC=[0xd8352a,0xf2c230,0x2a6fd1,0x2e9e57,0xe56aa8,0xf07c22];
function jeep(x,z,turn){ // jeepney
  const c=pick(JC),acc=pick(JC);
  const L=(geo,col,lx,ly,lz,sx,sy,sz,rx,rz)=>{if(turn)put(geo,col,x+lz,ly,z-lx,sx,sy,sz,rx||0,Math.PI/2,rz||0);else put(geo,col,x+lx,ly,z+lz,sx,sy,sz,rx||0,0,rz||0);};
  L(GB,c,0,1.05,0,2,1.1,5);L(GB,acc,0,1.3,0,2.04,.16,5.04);
  L(GB,0x262b31,0,1.95,-.3,1.9,.7,4.4);L(GB,0xcfd3d6,0,2.38,-.3,2.2,.16,5.2);
  L(GB,0xcfd3d6,0,.95,3.1,1.8,.85,1.3);L(GB,0x9aa0a6,0,1,3.78,1.6,.6,.1);L(GB,0x8fb4c8,0,1.85,2.45,1.8,.7,.08);
  L(GB,0xe2e2e2,0,1.55,3.55,.1,.3,.35);
  for(const sx of[-1,1])for(const sz of[-1.7,2.6])L(GC,0x1c1c1c,sx,.45,sz,.45,.32,.45,0,Math.PI/2);
  if(turn)solid(x-2.6,x+3.85,z-1.1,z+1.1,2.45);else solid(x-1.1,x+1.1,z-2.6,z+3.85,2.45);
}
function banderitas(ax,ay,az,bx,by,bz){ // fiesta flag strings
  const dx=bx-ax,dy=by-ay,dz=bz-az,len=Math.hypot(dx,dy,dz),n=Math.floor(len/.9),ry=Math.atan2(-dz,dx);
  const cols=[0xd8352a,0xf2c230,0x2a6fd1,0x2e9e57,0xffffff,0xe56aa8];let px=ax,py=ay,pz=az;
  for(let i=1;i<=n;i++){const t=i/n,x=ax+dx*t,y=ay+dy*t-Math.sin(t*Math.PI)*1.2,z=az+dz*t;fPos.push(px,py,pz,x,y,z);
    put(GTD,cols[i%cols.length],(px+x)/2,(py+y)/2-.26,(pz+z)/2,.32,.5,.04,0,ry,0);px=x;py=y;pz=z;}
  if(by<10)put(GC,0xb59a5a,bx,by/2,bz,.1,by,.1);
}

// roads and plaza
for(let s=-132;s<=132;s+=24){put(GB,0x4b4b4d,s,.02,0,7,.04,300);put(GB,0x4b4b4d,0,.025,s,300,.04,7);}
put(GB,0xb9ae96,0,.05,0,60,.06,60);
// church (Spanish-era stone church with bell tower)
(function(){const cx=0,cz=-18,adobe=0xc7ad84,adobe2=0xb89c74,roof=0x9a4a33,trim=0xd6c29c,dark=0x2b2520;
