  r.rotation.z+=(-g.lostSide*.25-r.rotation.z)*Math.min(1,dt*2);
  const ty=g.legsLost>=2?-.9*g.legLen:g.legsLost===1?-.25*g.legLen:0;r.position.y+=(ty-r.position.y)*Math.min(1,dt*2);
  const arms=g.parts.filter(p=>p.type==='arm'&&!p.cut);
