  if(e.code==='KeyE'&&!e.repeat&&P.alive){camera.getWorldPosition(tmp1);camera.getWorldDirection(tmp2);fireHook(1,tmp1,tmp2);}
  if(e.code==='KeyF'&&!e.repeat)desktopSlash();
  if(e.code==='Space')e.preventDefault();});
addEventListener('keyup',e=>{keys[e.code]=false;if(e.code==='KeyE')releaseHook(1);});
const cv=renderer.domElement;
cv.addEventListener('contextmenu',e=>e.preventDefault());
cv.addEventListener('mousedown',e=>{if(!started||inVR)return;initAudio();
  if(document.pointerLockElement!==cv){try{cv.requestPointerLock();}catch(err){}}
  if(!P.alive)return;
  if(e.button===0){camera.getWorldPosition(tmp1);camera.getWorldDirection(tmp2);fireHook(0,tmp1,tmp2);}
  if(e.button===2)desktopSlash();});
addEventListener('mouseup',e=>{if(e.button===0&&!inVR)releaseHook(0);});
addEventListener('mousemove',e=>{if(!started||inVR)return;
  if(document.pointerLockElement===cv||(e.buttons&1)){yaw-=e.movementX*.0025;pitch=clamp(pitch-e.movementY*.0025,-1.45,1.45);}});
function desktopSlash(){if(slashT<0&&P.alive){slashT=0;sfx('slash');}}

let snapLatch=false,jumpLatch=false;
const move=new THREE.Vector2();
function readInput(){
  move.set(0,0);let jump=false;
  if(inVR){const s=renderer.xr.getSession();if(s)for(const src of s.inputSources){const gp=src.gamepad;if(!gp)continue;
    const x=gp.axes[2]||0,y=gp.axes[3]||0;
    if(src.handedness==='left'){if(Math.hypot(x,y)>.15)move.set(x,y);}
    else{if(Math.abs(x)>.7&&!snapLatch){snapTurn(x>0?-Math.PI/6:Math.PI/6);snapLatch=true;}if(Math.abs(x)<.3)snapLatch=false;
      const a=gp.buttons[4]&&gp.buttons[4].pressed;if(a&&!jumpLatch)jump=true;jumpLatch=!!a;}}}
  else{
    if(keys.KeyW)move.y-=1;if(keys.KeyS)move.y+=1;if(keys.KeyA)move.x-=1;if(keys.KeyD)move.x+=1;
    if(keys.ArrowLeft)yaw+=.035;if(keys.ArrowRight)yaw-=.035;if(keys.ArrowUp)pitch=Math.min(1.45,pitch+.025);if(keys.ArrowDown)pitch=Math.max(-1.45,pitch-.025);
    if(keys.Space)jump=true;
    hooks[0].reel=hooks[1].reel=!!(keys.ShiftLeft||keys.ShiftRight);
    rig.rotation.y=yaw;camera.rotation.x=pitch;
  }
  if(move.lengthSq()>1)move.normalize();
  return jump;
}
function snapTurn(a){camera.getWorldPosition(tmp1);rig.rotation.y+=a;rig.updateMatrixWorld(true);camera.getWorldPosition(tmp2);
  rig.position.x+=tmp1.x-tmp2.x;rig.position.z+=tmp1.z-tmp2.z;}

/* ---------- physics ---------- */
const GRAV=-14;
function physics(dt,jump){
  const pos=rig.position,vel=P.vel;
  camera.getWorldDirection(tmp1);tmp1.y=0;if(tmp1.lengthSq()<1e-4)tmp1.set(0,0,-1);tmp1.normalize();
  tmp2.set(-tmp1.z,0,tmp1.x);
  const wx=tmp1.x*-move.y+tmp2.x*move.x,wz=tmp1.z*-move.y+tmp2.z*move.x;
  let pulling=false;
  for(let i=0;i<2;i++){const h=hooks[i];if(!h.active)continue;
    const ud=h.obj.userData;
    if((ud.part&&ud.part.cut)||(ud.giant&&ud.giant.removed)||!h.obj.parent){releaseHook(i);continue;}
    h.obj.localToWorld(h.point.copy(h.local));
    tmp3.subVectors(h.point,bodyW);const dist=tmp3.length();tmp3.normalize();
    let str=19;
    if(h.reel&&P.gas>0){str=44;P.gas-=26*dt;}else P.gas-=3*dt;
    if(P.gas<=0){P.gas=0;str=Math.min(str,9);}
    if(dist<2.5)str*=dist/2.5;
    vel.addScaledVector(tmp3,str*dt);pulling=true;
    hookOrigin(i,tmp4);const a=h.line.geometry.attributes.position.array;
    a[0]=tmp4.x;a[1]=tmp4.y;a[2]=tmp4.z;a[3]=h.point.x;a[4]=h.point.y;a[5]=h.point.z;h.line.geometry.attributes.position.needsUpdate=true;
    h.tip.position.copy(h.point);
  }
  if(!pulling)P.gas=Math.min(100,P.gas+(P.grounded?22:9)*dt);
  if(P.grounded&&!pulling){const k=Math.min(1,10*dt);vel.x+=(wx*7.5-vel.x)*k;vel.z+=(wz*7.5-vel.z)*k;}
  else{vel.x+=wx*7*dt;vel.z+=wz*7*dt;}
  if(jump&&P.grounded&&P.alive)vel.y=7.5;
  vel.y+=GRAV*dt;
  if(pulling)vel.multiplyScalar(1-.55*dt);
  const sp=vel.length();if(sp>46)vel.multiplyScalar(46/sp);
  pos.addScaledVector(vel,dt);
  P.grounded=false;
  if(pos.y<=0){pos.y=0;if(vel.y<0)vel.y=0;P.grounded=true;}
  camera.getWorldPosition(headW);
  const offX=headW.x-pos.x,offZ=headW.z-pos.z,R=.35;
  for(const b of boxes){const bx=pos.x+offX,bz=pos.z+offZ;
    if(bx>b.minX-R&&bx<b.maxX+R&&bz>b.minZ-R&&bz<b.maxZ+R&&pos.y<b.maxY&&pos.y+1.7>0){
      const dxL=bx-(b.minX-R),dxR=(b.maxX+R)-bx,dzL=bz-(b.minZ-R),dzR=(b.maxZ+R)-bz,dUp=b.maxY-pos.y;
      const m=Math.min(dxL,dxR,dzL,dzR,dUp);
      if(m===dUp&&dUp<1.2){pos.y=b.maxY;if(vel.y<0)vel.y=0;P.grounded=true;}
      else if(m===dxL){pos.x-=dxL;if(vel.x>0)vel.x=0;}
      else if(m===dxR){pos.x+=dxR;if(vel.x<0)vel.x=0;}
      else if(m===dzL){pos.z-=dzL;if(vel.z>0)vel.z=0;}
      else if(m===dzR){pos.z+=dzR;if(vel.z<0)vel.z=0;}
      else{pos.y=b.maxY;if(vel.y<0)vel.y=0;P.grounded=true;}}}
  const rr=Math.hypot(pos.x,pos.z);if(rr>165){pos.x*=165/rr;pos.z*=165/rr;}
  if(pos.y>140){pos.y=140;if(vel.y>0)vel.y=0;}
}

/* ---------- main loop ---------- */
const clock=new THREE.Clock();
makeKapre(15,36,-45,2.2);makeTikbalang(7,-34,-40,5); // the spirits you see from the start screen
function update(dt){
  const jump=readInput();
  camera.getWorldPosition(headW);bodyW.copy(headW);bodyW.y-=.6;
  physics(dt,jump);
  camera.getWorldPosition(headW);bodyW.copy(headW);bodyW.y-=.6;
  for(let i=giants.length-1;i>=0;i--)updateGiant(giants[i],dt);
  if(!inVR&&slashT>=0){slashT+=dt/.22;const t=Math.min(slashT,1),e=t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
    blades.forEach((b,i)=>{const s=i===0?-1:1;b.group.rotation.y=-s*(1.1-2.3*e);b.group.rotation.x=.6-.9*e;b.group.position.z=-.3-.15*Math.sin(t*Math.PI);});
    if(slashT>=1){slashT=-1;blades.forEach((b,i)=>{const s=i===0?-1:1;b.group.position.set(s*.32,-.3,-.3);b.group.rotation.set(.15,-s*.22,-s*.3);});}}
  if(P.alive)blades.forEach((b,i)=>checkBlade(b,i,dt));
  updateDebris(dt);updateParticles(dt);
  P.invuln=Math.max(0,P.invuln-dt);
  flash=Math.max(0,flash-dt*1.6);flashMesh.material.opacity=flash*.55;
  if(msgTimer>0){msgTimer-=dt;if(msgTimer<=0){$('msg').style.opacity=0;msgMesh.visible=false;}}
  missionTick(dt);
  hudClock-=dt;if(hudClock<=0){drawHUD();hudClock=.15;}
}
renderer.setAnimationLoop(()=>{const dt=Math.min(clock.getDelta(),.05);
  if(started)update(dt);else{rig.rotation.y=Math.sin(performance.now()*.00015)*.25;camera.rotation.x=.12;}
  renderer.render(scene,camera);});

/* ---------- menus / VR ---------- */
function renderMissions(){const list=$('missionList');list.innerHTML='';
  MISSIONS.forEach((m,i)=>{const b=document.createElement('button');b.className='mission';b.type='button';
    const locked=i>=unlocked,done=i<unlocked-1;
    b.innerHTML=`<span class="n">${m.endless?'∞':i+1}</span><span>${m.title}</span><span class="st">${locked?'Locked':done?'Done':'Ready'}</span>`;
    b.disabled=locked;b.setAttribute('aria-pressed',String(i===selected));
    b.addEventListener('click',()=>{selected=i;renderMissions();});list.appendChild(b);});}
renderMissions();
function begin(){started=true;initAudio();$('start').classList.add('hidden');
  $('hud').style.display=inVR?'none':'flex';$('cross').style.display=inVR?'none':'block';
  yaw=rig.rotation.y;pitch=0;startMission(selected);}
function toMenu(){started=false;gstate='idle';clearWorld();$('over').classList.add('hidden');$('hud').style.display='none';$('cross').style.display='none';
  $('msg').style.opacity=0;renderMissions();$('start').classList.remove('hidden');}
$('deskBtn').addEventListener('click',()=>{inVR=false;begin();try{cv.requestPointerLock();}catch(e){}});
$('primaryBtn').addEventListener('click',()=>{if(panelAction)panelAction();try{cv.requestPointerLock();}catch(e){}});
$('menuBtn').addEventListener('click',toMenu);
const vrBtn=$('vrBtn'),note=$('vrNote');
const noVR=()=>{vrBtn.textContent='VR not available';note.textContent='Open this page in the Meta Quest Browser to play in VR.';};
if(navigator.xr&&navigator.xr.isSessionSupported){
  navigator.xr.isSessionSupported('immersive-vr').then(ok=>{if(ok){vrBtn.disabled=false;vrBtn.textContent='Enter VR';}else noVR();}).catch(noVR);
}else noVR();
vrBtn.addEventListener('click',async()=>{
  try{
    const s=await navigator.xr.requestSession('immersive-vr',{optionalFeatures:['local-floor','bounded-floor']});
    renderer.xr.setReferenceSpaceType('local-floor');await renderer.xr.setSession(s);
    inVR=true;camera.position.set(0,0,0);camera.rotation.set(0,0,0);rig.rotation.set(0,0,0);
    blades.forEach((b,i)=>{grips[i].add(b.group);b.group.position.set(0,0,0);b.group.rotation.set(0,0,0);b.valid=false;});
    begin();
    s.addEventListener('end',()=>{inVR=false;camera.position.set(0,1.7,0);bladesToCamera();msgMesh.visible=false;toMenu();});
  }catch(err){note.textContent='VR was blocked on this page. Open the game from its own link in the Meta Quest Browser and try again.';}
});
addEventListener('resize',()=>{if(renderer.xr.isPresenting)return;camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});
})();
</script>
